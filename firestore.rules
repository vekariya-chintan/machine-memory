rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permit read and write for the manufacturing operations collections
    match /machines/{machineId} {
      allow read, write: if true;
    }
    match /incidents/{incidentId} {
      allow read, write: if true;
    }
    match /knowledge/{knowledgeId} {
      allow read, write: if true;
    }
    match /evidence/{evidenceId} {
      allow read, write: if true;
    }
    // Plant technicians directory in central database
    match /technicians/{technicianId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
