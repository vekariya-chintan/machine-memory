# ==============================================================================
# PromptNova MachineMemory - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT commit '.env' to version control (it is excluded via .gitignore).
# In Google Cloud Run, secrets are mounted from Google Cloud Secret Manager.
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API multimodal extraction & autonomous investigation.
# In local: obtain an API key from Google AI Studio (https://aistudio.google.com/app/apikey).
# In Cloud Run: mapped from Secret Manager via --set-secrets GEMINI_API_KEY=GEMINI_API_KEY:latest
# In AI Studio: automatically injected from AI Studio Secrets.
GEMINI_API_KEY="your-gemini-api-key-here"

# SESSION_SECRET: High-entropy secret key used for signing backend technician JWT session tokens.
# In local: set any secure random string (e.g. openssl rand -hex 32).
# In Cloud Run: mapped from Secret Manager via --set-secrets SESSION_SECRET=SESSION_SECRET:latest
SESSION_SECRET="your-high-entropy-session-secret-here"

# PORT: The port the HTTP server listens on (Cloud Run defaults to 8080, local defaults to 3000).
PORT=3000

# NODE_ENV: development | production
NODE_ENV=development

# APP_URL: The public hosting URL where this application is accessible.
APP_URL="http://localhost:3000"
