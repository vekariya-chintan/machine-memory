# ==============================================================================
# PromptNova MachineMemory - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT commit '.env' to version control (it is excluded via .gitignore).
# In Google Cloud Run, secrets are mounted from Google Cloud Secret Manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Vite Single Page Application)
# ------------------------------------------------------------------------------
# In Vite, client-side environment variables must start with 'VITE_'.
# These variables configure the Firebase Web SDK (Firestore, Auth, and Storage).
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_APP_ID="your-firebase-web-app-id"
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="your-project-database-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_DEFAULT_TECHNICIAN_PASSWORD="your-initial-default-password"

# ------------------------------------------------------------------------------
# 2. Server-Side Secrets & Configuration (Node.js & Express)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI multimodal extraction & RCA investigation.
# In local: obtain an API key from Google AI Studio (https://aistudio.google.com/app/apikey).
# In Cloud Run: mapped from Secret Manager via --set-secrets GEMINI_API_KEY=GEMINI_API_KEY:latest
# In AI Studio: automatically injected from AI Studio Secrets.
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional additional keys. Free-tier request allowance is granted per Google
# Cloud project, so these only add capacity when issued from SEPARATE projects.
# Keys are used in order and the pool advances when one is exhausted.
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# Per-key daily request allowance, and how much of it is held back for live
# repository queries so late-session questions always have budget.
AI_DAILY_LIMIT="20"
AI_QUERY_RESERVE="5"

# SESSION_SECRET: High-entropy secret key used for signing backend technician JWT session tokens.
# In local: set any secure random string (e.g. openssl rand -hex 32).
# In Cloud Run: mapped from Secret Manager via --set-secrets SESSION_SECRET=SESSION_SECRET:latest
SESSION_SECRET="your-high-entropy-session-secret-here"

# PORT: The port the HTTP server listens on (Cloud Run defaults to 8080, local defaults to 3000).
PORT=3000

# NODE_ENV: development | production
NODE_ENV=development

# APP_URL: The public hosting URL where this application is accessible.
APP_URL="http://localhost:3000"
